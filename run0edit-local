# Run run0edit in local directory, updating hash if necessary. Useful for testing.

set -euo pipefail

checksum=$(b2sum -l 256 run0edit_inner.py | cut -d' ' -f1)
sed --sandbox -i -e "/^INNER_SCRIPT_B2:/s/\".*\"/\"${checksum}\"/" run0edit_main.py
script="$(sed '/^INNER_SCRIPT_PATH:/s/".*"/"run0edit_inner.py"/' run0edit_main.py)"
python3 -c "$script" "$@"
